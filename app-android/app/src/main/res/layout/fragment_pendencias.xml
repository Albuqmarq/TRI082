<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/pend_voltar"
        style="@style/Voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pend_voltar" />

    <TextView
        style="@style/Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pend_titulo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/pend_descricao"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3" />

    <EditText
        android:id="@+id/pend_busca"
        style="@style/Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/pend_buscar"
        android:inputType="textNoSuggestions|textCapCharacters"
        android:importantForAutofill="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pend_contagem"
        style="@style/RotuloSecao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pend_cartao"
        style="@style/Cartao"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pend_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pend_vazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/pend_vazio"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
