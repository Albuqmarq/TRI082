<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/form_voltar"
                style="@style/Voltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_voltar" />

            <TextView
                android:id="@+id/form_titulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/texto_recomendar"
                style="@style/RotuloSecao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/form_recomendar"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_recomendacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView style="@style/CampoRotulo" android:layout_marginTop="20dp" android:text="@string/form_epc" />
            <EditText
                android:id="@+id/campo_epc"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:hint="@string/form_epc_hint"
                android:inputType="text"
                android:autofillHints="" />
            <TextView
                android:id="@+id/form_epc_ajuda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/form_epc_ajuda"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView style="@style/CampoRotulo" android:layout_marginTop="16dp" android:text="@string/form_nome" />
            <EditText
                android:id="@+id/campo_nome"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/form_nome_hint"
                android:inputType="text"
                android:autofillHints="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView style="@style/CampoRotulo" android:text="@string/form_categoria" />
                    <EditText android:id="@+id/campo_categoria" style="@style/Campo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/form_categoria_hint" android:inputType="text" android:autofillHints="" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/CampoRotulo" android:text="@string/form_cor" />
                    <EditText android:id="@+id/campo_cor" style="@style/Campo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/form_cor_hint" android:inputType="text" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView style="@style/CampoRotulo" android:text="@string/form_tipo" />
                    <EditText android:id="@+id/campo_tipo" style="@style/Campo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/form_tipo_hint" android:inputType="text" android:autofillHints="" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/CampoRotulo" android:text="@string/form_fornecedor" />
                    <EditText android:id="@+id/campo_fornecedor" style="@style/Campo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/form_fornecedor_hint" android:inputType="text" android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/branco"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/botao_cancelar"
            style="@style/Botao.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/form_cancelar"
            android:visibility="gone" />

        <Button
            android:id="@+id/botao_salvar"
            style="@style/Botao.Principal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/form_salvar" />
    </LinearLayout>

</LinearLayout>
