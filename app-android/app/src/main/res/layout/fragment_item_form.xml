<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/form_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/campo_epc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_epc"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/campo_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_nome"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/campo_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_categoria"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/campo_tipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_tipo"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/campo_cor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_cor"
            android:inputType="text"
            android:autofillHints="" />

        <EditText
            android:id="@+id/campo_fornecedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_fornecedor"
            android:inputType="text"
            android:autofillHints="" />

        <TextView
            android:id="@+id/texto_recomendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/form_recomendar"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_recomendacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <Button
            android:id="@+id/botao_salvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/form_salvar" />

    </LinearLayout>

</ScrollView>
