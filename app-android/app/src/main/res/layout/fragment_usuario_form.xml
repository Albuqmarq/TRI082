<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/uf_voltar"
                style="@style/Voltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uf_voltar" />

            <TextView
                android:id="@+id/uf_titulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/uf_area_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView style="@style/CampoRotulo" android:text="@string/uf_nome" />
                        <EditText
                            android:id="@+id/uf_campo_nome"
                            style="@style/Campo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/uf_nome_hint"
                            android:inputType="text"
                            android:autofillHints="" />
                    </LinearLayout>

                    <TextView style="@style/CampoRotulo" android:text="@string/uf_papel" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/uf_chip_funcionario"
                            style="@style/ChipEscolha"
                            android:layout_marginEnd="8dp"
                            android:text="@string/painel_papel_funcionario" />

                        <TextView
                            android:id="@+id/uf_chip_admin"
                            style="@style/ChipEscolha"
                            android:text="@string/painel_papel_admin" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/uf_rotulo_senha"
                        style="@style/CampoRotulo"
                        android:layout_marginTop="16dp"
                        android:text="@string/uf_senha" />
                    <EditText
                        android:id="@+id/uf_campo_senha"
                        style="@style/Campo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/uf_senha_hint"
                        android:inputType="textPassword"
                        android:autofillHints="" />
                    <TextView
                        android:id="@+id/uf_ajuda_senha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/uf_senha_ajuda_nova"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/uf_ativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/uf_ativo"
                        android:textColor="@color/texto"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/uf_aviso_propria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_alerta"
                        android:padding="12dp"
                        android:text="@string/uf_aviso_propria"
                        android:textColor="@color/alerta_texto"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/branco"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/uf_cancelar"
            style="@style/Botao.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/form_cancelar" />

        <Button
            android:id="@+id/uf_salvar"
            style="@style/Botao.Principal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/form_salvar" />
    </LinearLayout>

</LinearLayout>
