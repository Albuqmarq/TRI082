<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/config_voltar"
        style="@style/Voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_voltar" />

    <TextView
        style="@style/Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/config_titulo" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Cartao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/CampoRotulo" android:text="@string/config_ip" />
            <EditText
                android:id="@+id/campo_ip"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_ip_dica"
                android:inputType="text"
                android:autofillHints="" />

            <TextView style="@style/CampoRotulo" android:layout_marginTop="16dp" android:text="@string/config_porta" />
            <EditText
                android:id="@+id/campo_porta"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/config_porta_dica"
                android:inputType="number"
                android:autofillHints="" />

            <Button
                android:id="@+id/botao_salvar"
                style="@style/Botao.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/config_salvar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
