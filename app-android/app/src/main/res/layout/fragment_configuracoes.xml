<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_titulo"
        android:textSize="20sp"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_ip" />

    <EditText
        android:id="@+id/campo_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/config_ip_dica"
        android:inputType="text"
        android:autofillHints="" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_porta"
        android:paddingTop="12dp" />

    <EditText
        android:id="@+id/campo_porta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/config_porta_dica"
        android:inputType="number"
        android:autofillHints="" />

    <Button
        android:id="@+id/botao_salvar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/config_salvar" />

</LinearLayout>
