<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.tri082.inventario.ui.LoginFragment"
        android:label="@string/login_titulo">
        <action
            android:id="@+id/acao_login_para_painel"
            app:destination="@id/painelFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/painelFragment"
        android:name="com.tri082.inventario.ui.PainelFragment"
        android:label="@string/titulo_painel" />
    <fragment
        android:id="@+id/leituraFragment"
        android:name="com.tri082.inventario.ui.LeituraFragment"
        android:label="@string/titulo_leitura" />
    <fragment
        android:id="@+id/catalogoFragment"
        android:name="com.tri082.inventario.ui.CatalogoFragment"
        android:label="@string/titulo_catalogo" />
    <fragment
        android:id="@+id/inventarioFragment"
        android:name="com.tri082.inventario.ui.InventarioFragment"
        android:label="@string/titulo_inventario" />
    <fragment
        android:id="@+id/localizarFragment"
        android:name="com.tri082.inventario.ui.LocalizarFragment"
        android:label="@string/titulo_localizar" />
    <fragment
        android:id="@+id/configuracoesFragment"
        android:name="com.tri082.inventario.ui.ConfiguracoesFragment"
        android:label="@string/titulo_configuracoes" />
    <fragment
        android:id="@+id/itemDetalheFragment"
        android:name="com.tri082.inventario.ui.ItemDetalheFragment"
        android:label="@string/titulo_catalogo" />
    <fragment
        android:id="@+id/itemFormFragment"
        android:name="com.tri082.inventario.ui.ItemFormFragment"
        android:label="@string/titulo_catalogo" />

</navigation>
