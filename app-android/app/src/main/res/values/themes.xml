<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InventarioTRI082" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/verde</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorSurfaceContainerLow">@color/branco</item>
        <item name="colorSurfaceContainerHigh">@color/branco</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="ShapeRedonda12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/linha</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/branco</item>
    </style>

    <style name="Titulo">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Sobretitulo">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Voltar">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="RotuloSecao">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <style name="Campo">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Botao.Principal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/botao_principal_fundo</item>
        <item name="android:textColor">@color/branco</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Botao.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/linha</item>
        <item name="android:textColor">@color/texto</item>
        <item name="backgroundTint">@color/branco</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Botao.Quieto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Botao.Perigo" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/erro</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="NavegacaoInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/NavIndicador</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="NavIndicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/navy_suave</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="LinhaAcao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="LinhaAcaoTitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LinhaAcaoSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Divisoria">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/linha</item>
    </style>

    <style name="DetRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DetValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Passo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="PassoNumero">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@drawable/circulo_navy_suave</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PassoTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CampoRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="ChipEscolha">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_fundo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
